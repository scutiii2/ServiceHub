# Copy to .env. `docker compose` reads it automatically; for `run.bat` set these in the shell instead (the app does not load .env).

# Password for Start / Stop / Restart. Empty = those actions are disabled. Listing, opening and adding services need none.
HUB_ADMIN_PASSWORD=

# Local run only (Docker fixes these: port 29880, registry in the /data volume).
# HUB_PORT=29880
# HUB_DATA=data/services.json
